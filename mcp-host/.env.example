# _____Notice_______________________________________________________

## This is an example file.
## Copy and paste this into a .env file in the same path as this one.
## Then modify the values as needed.

# __________________________________________________________________

MCP_SERVER_URL=http://localhost:8787
MCP_API_KEY=your-mcp-api-key
GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-3.6-flash

# WhatsApp Cloud API (Meta). Use WHATSAPP_DRY_RUN=true to log replies instead of sending them.
WHATSAPP_VERIFY_TOKEN=any-string-you-also-set-in-meta
WHATSAPP_APP_SECRET=your-meta-app-secret
WHATSAPP_ACCESS_TOKEN=your-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_DRY_RUN=true
