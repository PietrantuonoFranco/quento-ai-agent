# _____Notice_______________________________________________________

## This is an example file.
## Copy and paste this into a .env file in the same path as this one.
## Then modify the values as needed.

# __________________________________________________________________

DATABASE_URL="postgres://user:password@localhost:5432/quento"
MCP_API_KEY="your_api_key"
PORT=8787

# Opcional: WhatsApp Cloud API del club, para que las tools avisen a los afectados
# (otros jugadores de un partido, alumnos de una clase). Usa las mismas plantillas
# aprobadas en Meta que la web. Sin token o sin phone number id no se manda nada.
# WHATSAPP_ACCESS_TOKEN="your-access-token"
# WHATSAPP_PHONE_NUMBER_ID="your-phone-number-id"
# WHATSAPP_API_VERSION="v23.0"
# WHATSAPP_TEMPLATE_LANGUAGE="es_AR"
